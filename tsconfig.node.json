{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2023"], "types": ["node"],
    "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "isolatedModules": true, "moduleDetection": "force", "skipLibCheck": true, "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts", "tests", "src/astro"]
}
