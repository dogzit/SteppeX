{
  "name": "lunar-navigator",
  "version": "1.0.0",
  "description": "Lunar Navigator — explore lunar landing sites, sunlight, and direct-to-Earth visibility.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "data": "npm run data:ephem && npm run data:textures && npm run data:horizons && npm run data:tiles",
    "data:ephem": "tsx scripts/build-ephemeris.ts",
    "data:textures": "tsx scripts/build-normalmap.ts && python3 scripts/build-textures.py",
    "data:horizons": "tsx scripts/build-horizons.ts",
    "data:tiles": "tsx scripts/build-dem-tiles.ts",
    "validate": "tsx scripts/validate.ts",
    "validate:horizon": "tsx scripts/validate-horizon.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "astronomy-engine": "^2.1.19",
    "d3": "^7.9.2",
    "framer-motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
